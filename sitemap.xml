---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {%- assign sitemap_pages = site.pages | sort: 'url' -%}
  {%- for sitemap_page in sitemap_pages -%}
    {%- if sitemap_page.layout == 'homepage' or sitemap_page.layout == 'default' -%}
      {%- unless sitemap_page.sitemap == false %}
  <url>
    <loc>{{ sitemap_page.url | absolute_url | xml_escape }}</loc>
  </url>
      {%- endunless -%}
    {%- endif -%}
  {%- endfor %}
</urlset>
